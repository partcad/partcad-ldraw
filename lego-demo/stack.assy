# Two 2x4 bricks (LDraw 3001), mated stud->anti-stud and perfectly aligned. The
# upper brick sits exactly one brick-height (9.6 mm) above the lower one.
links:
  - part: //pub/universe/lego/ldraw/Brick:3001
    name: lower

  - part: //pub/universe/lego/ldraw/Brick:3001
    name: upper
    connect:
      with: //pub/universe/lego:anti-stud
      withInstance: c0r0
      name: lower
      to: //pub/universe/lego:stud
      toInstance: c0r0
