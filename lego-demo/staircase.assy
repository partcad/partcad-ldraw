# A staircase of 1x4 bricks. Each step connects its left-most anti-stud (c0r0)
# to the third stud (c2r0) of the step below, so every step rises one brick
# (9.6 mm) and shifts two studs (16 mm) along X.
links:
  - part: brick-1x4
    name: step0

  - part: brick-1x4
    name: step1
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: step0
      to: lego-stud
      toInstance: c2r0

  - part: brick-1x4
    name: step2
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: step1
      to: lego-stud
      toInstance: c2r0

  - part: brick-1x4
    name: step3
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: step2
      to: lego-stud
      toInstance: c2r0
