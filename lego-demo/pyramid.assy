# Bricks + plate + tile of different sizes joined by interface mating:
#   - a 2x4 brick base,
#   - two 2x2 bricks seated on its left and right halves,
#   - a 2x4 plate bridging across both 2x2 bricks,
#   - a 2x2 tile capping the plate.
links:
  - part: brick-2x4
    name: base

  - part: brick-2x2
    name: capL
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: base
      to: lego-stud
      toInstance: c0r0

  - part: brick-2x2
    name: capR
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: base
      to: lego-stud
      toInstance: c2r0

  - part: plate-2x4
    name: deck
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: capL
      to: lego-stud
      toInstance: c0r0

  - part: tile-2x2
    name: roof
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: deck
      to: lego-stud
      toInstance: c1r0
