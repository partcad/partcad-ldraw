# Different sizes joined into an arch: a 2x4 brick base, two 2x2 bricks standing
# on its left and right halves as pillars, and a 2x4 brick bridging across both
# pillars two brick-heights up. Everything is connected purely by stud->anti-stud
# interface mating.
links:
  - part: brick-2x4
    name: base

  - part: brick-2x2
    name: pillarL
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: base
      to: lego-stud
      toInstance: c0r0

  - part: brick-2x2
    name: pillarR
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: base
      to: lego-stud
      toInstance: c2r0

  - part: brick-2x4
    name: bridge
    connect:
      with: lego-anti-stud
      withInstance: c0r0
      name: pillarL
      to: lego-stud
      toInstance: c0r0
